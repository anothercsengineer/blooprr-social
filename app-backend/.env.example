# ==========================================
# BLOOPRR BACKEND ENVIRONMENT VARIABLES
# ==========================================

# --------- [SERVER CONFIGURATION] ---------
 # port the node.js 
 # express server will listen on
PORT=3001

# ------ [AUTHENTICATION & SECURITY] -------
 # used to sign and verify 
 # JSON web tokens (JWT) for user sessions
JWT_SECRET=your_jwt_secret_here

# ------------- [CRYPTOGRAPHY] -------------
 # static, secret salt mixed with phone 
 # numbers BEFORE hashing.
PHONE_PEPPER=your_phone_pepper_here

# ------------ [NETWORK & CORS] ------------
 # allowed origins for CORS
 # Use '*' for local development, specific domains for production
CORS_ALLOWED_ORIGIN=*

# ----------- [THIRD-PARTY APIS] -----------
 # reserved for future API keys
 # AWS_SECRET_KEY=sk_test_...
